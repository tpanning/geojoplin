{
	"name": "geojoplin",
	"version": "0.1.1",
	"private": true,
	"description": "View your Joplin notes on a geographical map",
	"author": "Tom Panning",
	"main": "dist-electron/main.js",
	"scripts": {
		"start": "vite",
		"app:dir": "electron-builder --dir",
		"app:dist": "electron-builder",
		"build": "vite build",
		"lint": "eslint . --ext .ts,.tsx --quiet",
		"lint-fix": "eslint . --ext .ts,.tsx --fix --quiet",
		"test": "jest"
	},
	"build": {
		"appId": "org.penkey.GeoJoplin",
		"productName": "GeoJoplin",
		"afterSign": "electron-builder-notarize",
		"files": [
			"dist/**",
			"dist-electron/**"
		],
		"mac": {
			"category": "public.app-category.productivity",
			"hardenedRuntime": true
		}
	},
	"dependencies": {
		"@fortawesome/fontawesome-free": "^7.3.1",
		"@fortawesome/fontawesome-svg-core": "^7.3.1",
		"@fortawesome/free-solid-svg-icons": "^7.3.1",
		"dompurify": "^3.4.17",
		"leaflet": "^1.9.4",
		"marked": "^18.1.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1"
	},
	"devDependencies": {
		"@electron/notarize": "^3.1.2",
		"@seiyab/eslint-plugin-react-hooks": "4.5.1-beta.0",
		"@types/dompurify": "^3.0.5",
		"@types/jest": "^30.0.0",
		"@types/leaflet": "^1.9.22",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@typescript-eslint/eslint-plugin": "^8.71.2",
		"@typescript-eslint/parser": "^8.71.2",
		"@vitejs/plugin-react": "^4.7.0",
		"electron": "^41.10.7",
		"electron-builder": "^26.15.3",
		"electron-builder-notarize": "^1.5.2",
		"eslint": "^8.57.1",
		"eslint-plugin-github": "^5.1.8",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-jest": "^28.14.0",
		"eslint-plugin-promise": "^7.3.0",
		"eslint-plugin-react": "^7.37.5",
		"jest": "^30.5.2",
		"jest-environment-jsdom": "^30.5.2",
		"ts-jest": "^29.4.15",
		"typescript": "^5.9.3",
		"vite": "^6.4.4",
		"vite-plugin-electron": "^0.29.1"
	},
	"engines": {
		"node": ">=18"
	}
}
